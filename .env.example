# Application
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Database
DB_HOST=rag-database
DB_PORT=5432
DB_PUBLIC_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=rag_db
DATABASE_URL=postgresql://myuser:mypassword@rag-database:5432/rag_db

# AI / RAG options
EMBEDDING_MODEL=text-embedding-3-small
USE_DB_PROMPTS=false
USE_RAG_SEARCH=false
RAG_TOP_K=5
